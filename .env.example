# Example environment for `docker run --env-file .env.example` or docker compose.
# `manage.py` loads a local .env via python-dotenv (dev dependency); the image does NOT,
# so the runtime must inject these variables there. Real env vars override .env.
# Placeholder values only - never commit real secrets.

# Required when DJANGO_DEBUG is off.
SECRET_KEY=change-me
# Postgres connection URL; unset means SQLite (db.sqlite3).
DATABASE_URL=postgres://user:password@db:5432/locallibrary
# Keep 0 in production (the image already sets it; do not override to 1).
# settings.py defaults to off, but manage.py defaults to on for local dev.
DJANGO_DEBUG=0
# Comma-separated hostnames Django will serve.
DJANGO_ALLOWED_HOSTS=library.example.com,www.library.example.com
# Comma-separated origins with scheme, for CSRF checks behind TLS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://library.example.com
# Set to 1 to trust X-Forwarded-Proto from the ingress (TLS terminated upstream).
DJANGO_TRUST_PROXY_PROTO=1
# Ingress/proxy address or CIDR uvicorn trusts for forwarded headers (default 127.0.0.1 only).
FORWARDED_ALLOW_IPS=10.0.0.0/8
# OpenSearch endpoint (default http://localhost:9200).
OPENSEARCH_URL=http://opensearch:9200
# Number of uvicorn worker processes (default 1).
WEB_CONCURRENCY=1
# Password given to every user created by `manage.py seed` (dev only; seed refuses to run without it).
SEED_USER_PASSWORD=change-me
